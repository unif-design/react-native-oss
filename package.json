{
  "name": "@unif/react-native-oss",
  "version": "0.1.1",
  "description": "React Native OSS 临时凭证、上传与转存",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "unif-react-native-oss-source": {
        "browser": "./src/index.web.ts",
        "default": "./src/index.ts"
      },
      "types": "./lib/typescript/src/index.d.ts",
      "browser": "./lib/module/index.web.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @unif/react-native-oss-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p example/tsconfig.json",
    "lint": "eslint src __tests__ example/src scripts jest.config.cjs jest.sdk.config.cjs babel.config.cjs --max-warnings=0",
    "build": "bob build",
    "test": "jest --config jest.config.cjs --watchman=false",
    "release": "release-it --only-version",
    "website": "yarn workspace @unif/react-native-oss-website",
    "test:native:android": "python3 scripts/patches/react-native-blob-util/check_oss_upload_streams.py",
    "test:native:ios": "python3 scripts/patches/react-native-blob-util/check_oss_upload_form.py",
    "test:sdk": "jest --config jest.sdk.config.cjs --runInBand --watchman=false",
    "verify:consumer": "node scripts/verify-consumer.cjs"
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unif-design/react-native-oss.git"
  },
  "author": "unif-design",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/unif-design/react-native-oss/issues"
  },
  "homepage": "https://unif-design.github.io/react-native-oss/",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@commitlint/config-conventional": "21.2.0",
    "@dr.pogodin/react-native-fs": "2.41.0",
    "@dr.pogodin/react-native-static-server": "0.28.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "12.0.0",
    "@types/crypto-js": "4.2.2",
    "@types/jest": "30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "~19.3.0",
    "@unif/react-native-files": "^0.1.0",
    "@unif/react-native-logger": "0.1.3",
    "commitlint": "21.2.1",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "hermes-eslint": "0.37.0",
    "jest": "30.5.2",
    "lefthook": "2.1.10",
    "prettier": "^3.9.10",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-blob-util": "0.25.1",
    "react-native-builder-bob": "^0.44.1",
    "react-native-nitro-modules": "0.37.1",
    "react-native-quick-base64": "3.0.1",
    "react-native-quick-crypto": "1.1.8",
    "release-it": "21.0.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@unif/react-native-files": "^0.1.0",
    "@unif/react-native-logger": "^0.1.3",
    "react": "^19.3.0",
    "react-native": ">=0.88.0",
    "react-native-blob-util": "0.25.1"
  },
  "workspaces": [
    "example",
    "website"
  ],
  "packageManager": "yarn@4.18.1",
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "all",
    "useTabs": false
  },
  "create-react-native-library": {
    "type": "library",
    "languages": "js",
    "tools": [
      "eslint"
    ],
    "version": "0.64.0"
  },
  "dependencies": {
    "crypto-js": "4.2.0",
    "react-native-url-polyfill": "4.0.0"
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: 发布 ${version} [skip ci]",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true,
      "skipChecks": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "resolutions": {
    "@react-native/eslint-config/eslint-plugin-ft-flow": "3.0.11"
  }
}
